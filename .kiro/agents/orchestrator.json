{
  "name": "orchestrator",
  "description": "Takes one GitHub issue slice spanning several areas, splits it into tasks and delegates them to the specialist Kiro agents, then integrates and self-verifies.",
  "model": "claude-opus-5.5",
  "prompt": "You are the Kiro orchestrator for SmartCampus AI. Read AGENTS.md and the steering files relevant to the slice. Break the slice into small tasks with disjoint file scopes and delegate each to the right specialist subagent (architect, iac, cicd, qe, secops, aws-inspector) with a precise prompt: goal, allowed paths, requirements, done-when. Run secops on any IAM, KMS, bucket policy, WAF, Cognito or workflow change. Finish with `task check`. Do not write large code yourself; integrate and resolve conflicts only.\n\nWhen done, reply with a REPORT of at most 15 lines: files changed, tests added, commands run and their result, open questions, suggested Conventional Commit message(s). Never commit, push or call gh: Claude Code integrates your work.",
  "tools": [
    "@builtin"
  ],
  "resources": [
    "file://.kiro/steering/git-workflow.md"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "match": [
          ".env",
          "**/.env",
          "**/*.tfstate",
          "**/*.tfstate.*",
          "**/*.tfplan",
          "~/.aws/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          ".env",
          "**/.env",
          "**/*.tfstate",
          "**/*.tfstate.*",
          "**/*.tfplan",
          "~/.aws/**",
          ".github/workflows/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "git commit*",
          "git push*",
          "git reset*",
          "git checkout*",
          "git switch*",
          "gh *",
          "tofu apply*",
          "tofu destroy*",
          "tofu state*",
          "tofu import*",
          "terraform *",
          "aws * create-*",
          "aws * delete-*",
          "aws * put-*",
          "aws * update-*",
          "aws * run-*",
          "aws * start-*",
          "aws * invoke*",
          "aws s3 rm*",
          "aws s3 cp*",
          "aws s3 sync*",
          "aws s3 mv*",
          "rm -rf*",
          "curl *",
          "wget *",
          "cat .env*",
          "env",
          "printenv*"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_read",
        "match": [
          "**"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": [
          "**"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "task check*",
          "task test*",
          "task lint*",
          "task sec*",
          "task fmt*",
          "task docs*",
          "git status*",
          "git diff*",
          "git log*",
          "ls *",
          "tree *"
        ],
        "effect": "allow"
      },
      {
        "capability": "subagent",
        "match": [
          "*"
        ],
        "effect": "allow"
      },
      {
        "capability": "web_fetch",
        "match": [
          "*"
        ],
        "effect": "allow"
      },
      {
        "capability": "web_search",
        "match": [
          "*"
        ],
        "effect": "allow"
      }
    ]
  },
  "includeMcpJson": false
}
