{
  "name": "cicd-glm",
  "description": "CI/CD engineer (low-cost variant): workflows and tooling changes that do not touch credentials, OIDC or deployment permissions (use cicd for those).",
  "model": "glm-5",
  "prompt": "You are a senior DevSecOps CI/CD engineer. Implement the requested workflows/tooling following the cicd and security steering: pinned SHAs, minimal permissions, OIDC only, reusable workflows, Taskfile as single entry point. Validate with actionlint and zizmor, then `task check`.\n\nWhen done, reply with a REPORT of at most 15 lines: files changed, tests added, commands run and their result, open questions, suggested Conventional Commit message(s). Never commit, push or call gh: Claude Code integrates your work.",
  "tools": [
    "@builtin"
  ],
  "resources": [
    "file://.kiro/steering/cicd.md"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "match": [
          ".env",
          "**/.env",
          "**/*.tfstate",
          "**/*.tfstate.*",
          "**/*.tfplan",
          "~/.aws/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          ".env",
          "**/.env",
          "**/*.tfstate",
          "**/*.tfstate.*",
          "**/*.tfplan",
          "~/.aws/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "git commit*",
          "git push*",
          "git reset*",
          "git checkout*",
          "git switch*",
          "gh *",
          "tofu apply*",
          "tofu destroy*",
          "tofu state*",
          "tofu import*",
          "terraform *",
          "aws * create-*",
          "aws * delete-*",
          "aws * put-*",
          "aws * update-*",
          "aws * run-*",
          "aws * start-*",
          "aws * invoke*",
          "aws s3 rm*",
          "aws s3 cp*",
          "aws s3 sync*",
          "aws s3 mv*",
          "rm -rf*",
          "curl *",
          "wget *",
          "cat .env*",
          "env",
          "printenv*"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_read",
        "match": [
          "**"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": [
          ".github/**",
          "Taskfile.yml",
          "taskfiles/**",
          ".mise.toml",
          "lefthook.yml",
          "commitlint.config.*",
          ".commitlintrc*",
          "release-please-config.json",
          ".release-please-manifest.json",
          "renovate.json",
          ".editorconfig",
          ".gitignore",
          ".tflint.hcl",
          ".checkov.yaml",
          ".gitleaks.toml",
          ".trivyignore",
          "docs/runbooks/**"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "task check*",
          "task test*",
          "task lint*",
          "task sec*",
          "task fmt*",
          "task docs*",
          "git status*",
          "git diff*",
          "git log*",
          "ls *",
          "tree *",
          "actionlint*",
          "zizmor*",
          "lefthook *"
        ],
        "effect": "allow"
      },
      {
        "capability": "subagent",
        "match": [
          "*"
        ],
        "effect": "deny"
      },
      {
        "capability": "web_fetch",
        "match": [
          "*"
        ],
        "effect": "allow"
      },
      {
        "capability": "web_search",
        "match": [
          "*"
        ],
        "effect": "allow"
      }
    ]
  },
  "includeMcpJson": false
}
