{
  "name": "mech",
  "description": "Mechanical changes: docs, module READMEs, repetitive tests, small fixes. Never IAM, KMS, WAF, Cognito, S3 policies or workflows.",
  "model": "qwen3-coder-next",
  "prompt": "You are the quality engineer (QE). Write deterministic, idempotent tests named after acceptance criteria IDs, following the testing steering. Always include the mandatory security cases (401/403, BOLA, upload limits, WAF rate limit, grounded refusal). Keep docs/qa/traceability.md up to date.\n\nWhen done, reply with a REPORT of at most 15 lines: files changed, tests added, commands run and their result, open questions, suggested Conventional Commit message(s). Never commit, push or call gh: Claude Code integrates your work.",
  "tools": [
    "@builtin"
  ],
  "resources": [
    "file://.kiro/steering/testing.md"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "match": [
          ".env",
          "**/.env",
          "**/*.tfstate",
          "**/*.tfstate.*",
          "**/*.tfplan",
          "~/.aws/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          ".env",
          "**/.env",
          "**/*.tfstate",
          "**/*.tfstate.*",
          "**/*.tfplan",
          "~/.aws/**",
          ".github/workflows/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "git commit*",
          "git push*",
          "git reset*",
          "git checkout*",
          "git switch*",
          "gh *",
          "tofu apply*",
          "tofu destroy*",
          "tofu state*",
          "tofu import*",
          "terraform *",
          "aws * create-*",
          "aws * delete-*",
          "aws * put-*",
          "aws * update-*",
          "aws * run-*",
          "aws * start-*",
          "aws * invoke*",
          "aws s3 rm*",
          "aws s3 cp*",
          "aws s3 sync*",
          "aws s3 mv*",
          "rm -rf*",
          "curl *",
          "wget *",
          "cat .env*",
          "env",
          "printenv*"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_read",
        "match": [
          "**"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": [
          "docs/**",
          "tests/**",
          "infra/modules/*/README.md",
          "infra/modules/*/tests/**",
          "infra/modules/*/examples/**"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "task check*",
          "task test*",
          "task lint*",
          "task sec*",
          "task fmt*",
          "task docs*",
          "git status*",
          "git diff*",
          "git log*",
          "ls *",
          "tree *",
          "tofu test*",
          "tofu init -backend=false*",
          "hurl --test*",
          "k6 inspect*",
          "npx playwright test --list*"
        ],
        "effect": "allow"
      },
      {
        "capability": "subagent",
        "match": [
          "*"
        ],
        "effect": "deny"
      },
      {
        "capability": "web_fetch",
        "match": [
          "*"
        ],
        "effect": "allow"
      },
      {
        "capability": "web_search",
        "match": [
          "*"
        ],
        "effect": "allow"
      }
    ]
  },
  "includeMcpJson": false
}
