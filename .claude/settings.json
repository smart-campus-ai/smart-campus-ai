{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Agent",
      "Read(./.env)",
      "Read(**/.env)",
      "Read(~/.aws/**)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(**/*.tfplan)",
      "Bash(cat .env*)",
      "Bash(env)",
      "Bash(printenv*)",
      "Bash(tofu apply*)",
      "Bash(tofu destroy*)",
      "Bash(terraform *)",
      "Bash(aws * delete-*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(gh repo delete*)",
      "Bash(gh secret *)",
      "Bash(kiro-cli*--trust-all-tools*)",
      "Bash(git push -u origin main*)",
      "Bash(git push --set-upstream origin main*)"
    ],
    "ask": [
      "Bash(gh pr merge*)",
      "Bash(gh issue close*)",
      "Bash(gh issue delete*)",
      "Bash(gh repo edit*)",
      "Bash(gh api -X DELETE*)",
      "Bash(gh api --method DELETE*)",
      "Bash(gh api -X PUT*)",
      "Bash(gh api --method PUT*)",
      "Bash(gh variable set*)"
    ],
    "allow": [
      "Bash(task *)",
      "Bash(kiro-cli chat --v3 --no-interactive --agent *)",
      "Bash(kiro-cli agent list*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git switch*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push -u origin *)",
      "Bash(git push origin *)",
      "Bash(gh issue list*)",
      "Bash(gh issue view*)",
      "Bash(gh issue create*)",
      "Bash(gh issue edit*)",
      "Bash(gh issue comment*)",
      "Bash(gh issue develop*)",
      "Bash(gh pr create*)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr diff*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh run watch*)",
      "Bash(gh label *)",
      "Bash(tofu fmt*)",
      "Bash(tofu init*)",
      "Bash(tofu validate*)",
      "Bash(tofu test*)",
      "Bash(tofu plan*)",
      "Bash(tofu show*)",
      "Bash(git remote*)",
      "Bash(git branch*)",
      "Bash(git init*)",
      "Bash(git check-ignore*)",
      "Bash(gh auth status*)",
      "Bash(gh repo view*)",
      "Bash(gh project *)",
      "Bash(gh variable list*)",
      "Bash(kiro-cli --version*)",
      "Bash(mise *)",
      "Bash(gh api repos/smart-campus-ai/smart-campus-ai/issues*)",
      "Bash(gh api repos/Pawpawzz/smart-campus-ai/issues*)"
    ]
  }
}
