# EN83-AC4 / US04-AC5 / EN-43-AC2 presigned POST conditions: image <= 10 MB only (SMK-020, SEC-007, SEC-008).
# Variables: spa_url, student_a_token, ticket_category.
# Local files, resolved from --file-root (generated by the runner, never committed, see docs/qa/smoke-and-security-tests.md):
#   qa-small.bin     1 KiB
#   qa-oversize.bin  10 MiB + 1 byte
# Assumed contract (to align with packages/contracts): POST /api/tickets/{id}/attachments {filename, contentType}
#   -> 200/201 {url, fields{key, policy, x-amz-algorithm, x-amz-credential, x-amz-date, x-amz-signature, x-amz-security-token}}.
#   The Content-Type form field is chosen by the client and constrained by the policy (image types only).
# Data: the valid upload leaves one 1 KiB object under the ticket prefix; the bucket lifecycle expires it.

# EN83-AC4 create the ticket that owns the attachments
POST {{spa_url}}/api/tickets
Authorization: Bearer {{student_a_token}}
Content-Type: application/json
{
  "title": "qa-{{newUuid}}",
  "description": "qa upload limits",
  "category": "{{ticket_category}}"
}
HTTP 201
[Captures]
ticket_id: jsonpath "$.id"

# SMK-020 presigned POST is issued for a valid image
POST {{spa_url}}/api/tickets/{{ticket_id}}/attachments
Authorization: Bearer {{student_a_token}}
Content-Type: application/json
{
  "filename": "qa-small.png",
  "contentType": "image/png"
}
HTTP *
[Asserts]
status >= 200
status <= 201
jsonpath "$.url" startsWith "https://"
jsonpath "$.fields.key" exists
jsonpath "$.fields.policy" exists
[Captures]
upload_url: jsonpath "$.url"
f_key: jsonpath "$.fields.key"
f_policy: jsonpath "$.fields.policy"
f_algorithm: jsonpath "$.fields['x-amz-algorithm']"
f_credential: jsonpath "$.fields['x-amz-credential']"
f_date: jsonpath "$.fields['x-amz-date']"
f_signature: jsonpath "$.fields['x-amz-signature']"
f_token: jsonpath "$.fields['x-amz-security-token']"

# EN83-AC4 valid image within the limit is accepted (positive control: fields and signature are good)
POST {{upload_url}}
[Multipart]
key: {{f_key}}
Content-Type: image/png
policy: {{f_policy}}
x-amz-algorithm: {{f_algorithm}}
x-amz-credential: {{f_credential}}
x-amz-date: {{f_date}}
x-amz-security-token: {{f_token}}
x-amz-signature: {{f_signature}}
file: file,qa-small.bin; image/png
HTTP 204

# SEC-007 upload above 10 MB is rejected by the policy (content-length-range)
POST {{upload_url}}
[Multipart]
key: {{f_key}}
Content-Type: image/png
policy: {{f_policy}}
x-amz-algorithm: {{f_algorithm}}
x-amz-credential: {{f_credential}}
x-amz-date: {{f_date}}
x-amz-security-token: {{f_token}}
x-amz-signature: {{f_signature}}
file: file,qa-oversize.bin; image/png
HTTP 400
[Asserts]
body contains "EntityTooLarge"

# SEC-008 non-image content type is rejected by the policy
POST {{upload_url}}
[Multipart]
key: {{f_key}}
Content-Type: text/html
policy: {{f_policy}}
x-amz-algorithm: {{f_algorithm}}
x-amz-credential: {{f_credential}}
x-amz-date: {{f_date}}
x-amz-security-token: {{f_token}}
x-amz-signature: {{f_signature}}
file: file,qa-small.bin; text/html
HTTP 403
[Asserts]
body contains "Policy Condition failed"

# SEC-008 executable content type is rejected by the policy
POST {{upload_url}}
[Multipart]
key: {{f_key}}
Content-Type: application/x-msdownload
policy: {{f_policy}}
x-amz-algorithm: {{f_algorithm}}
x-amz-credential: {{f_credential}}
x-amz-date: {{f_date}}
x-amz-security-token: {{f_token}}
x-amz-signature: {{f_signature}}
file: file,qa-small.bin; application/x-msdownload
HTTP 403
[Asserts]
body contains "Policy Condition failed"

# EN83-AC4 a key outside the signed prefix is rejected (the policy pins the object key)
POST {{upload_url}}
[Multipart]
key: qa-other-prefix/{{ticket_id}}/qa-small.png
Content-Type: image/png
policy: {{f_policy}}
x-amz-algorithm: {{f_algorithm}}
x-amz-credential: {{f_credential}}
x-amz-date: {{f_date}}
x-amz-security-token: {{f_token}}
x-amz-signature: {{f_signature}}
file: file,qa-small.bin; image/png
HTTP 403
