# SmartCampus AI — frontend environment (copy to .env.local, git-ignored).
# With mocks enabled the SPA runs fully offline (no AWS needed).

# Use the in-memory mock API + mock login (default: true).
VITE_USE_MOCKS=true

# Real API base URL. Behind CloudFront this is "/api" (same origin, no CORS).
VITE_API_BASE_URL=/api

# Public CloudFront URL of the environment, used for shareable ticket links (US09).
# Defaults to window.location.origin when empty.
VITE_APP_BASE_URL=

# Cognito Hosted UI (authorization code + PKCE, no client secret).
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_SCOPE=openid email profile
VITE_COGNITO_REDIRECT_URI=

# US06 — Microsoft Entra ID federation (behind the feature flag).
VITE_ENABLE_ENTRA_FEDERATION=false
VITE_COGNITO_ENTRA_IDP=
