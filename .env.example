# Copy to `.env` (git-ignored, loaded by mise). Never commit real values.
# AI agents are denied read access to `.env`.
# No AWS keys here: credentials live in ~/.aws (profile below) and are short-lived.

# --- AWS ---------------------------------------------------------------
AWS_PROFILE=smartcampus-ws
AWS_REGION=us-east-1
AWS_PAGER=

# --- OpenTofu inputs (non-secret) ---------------------------------------
TF_VAR_project=smartcampus
TF_VAR_owner=
TF_VAR_alert_email=
TF_VAR_allowed_email_domain=
TF_VAR_enable_custom_domain=false
TF_VAR_enable_entra_federation=false

# --- GitHub --------------------------------------------------------------
# gh uses its own keyring auth; do not put a token here.
GH_REPO=smart-campus-ai/smart-campus-ai

# --- Local-only tooling secrets ------------------------------------------
INFRACOST_API_KEY=
