# Copy to terraform.tfvars and replace the placeholders. Do not commit the filled-in file (it holds your account ID).
#
# Principals that administer the state KMS key (including ScheduleKeyDeletion, DisableKey, PutKeyPolicy) and the
# recovery settings of the state bucket. Include the identity that runs the bootstrap apply and a break-glass principal.
# They must already exist. Never list a CI role.
admin_principal_arns = [
  "arn:aws:iam::<account-id>:role/<bootstrap-admin-role>",
  "arn:aws:iam::<account-id>:role/<break-glass-role>",
]

# GitHub OIDC (EN-13). Off by default: the workshop account has no GitHub OIDC provider and does not allow the CI roles
# (ADR-0014, ADR-0016). Enable only in an account that allows them; the defaults below suit this repository.
#
# create_ci_roles   = true
# github_repository = "smart-campus-ai/smart-campus-ai"
# allowed_regions   = ["us-east-1"]

# With create_ci_roles = true, either create the provider (an account holds a single one per URL) ...
# create_oidc_provider       = true
# ... or reference the existing one:
# existing_oidc_provider_arn = "arn:aws:iam::<account-id>:oidc-provider/token.actions.githubusercontent.com"
