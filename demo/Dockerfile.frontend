# Frontend demo image: build the Vite SPA, serve it with nginx, proxy /api to
# the demo gateway. Demo aid only (prod serves the SPA from S3 behind CloudFront).
FROM node:24-bookworm-slim AS build
WORKDIR /app

# Enable the pinned pnpm via corepack.
RUN corepack enable

COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN corepack pnpm install --frozen-lockfile

COPY frontend/ ./
# Demo build: use the real HTTP client against /api, with the demo role buttons
# issuing demo bearer tokens the gateway understands.
ENV VITE_USE_MOCKS=false
ENV VITE_DEMO_TOKENS=true
ENV VITE_API_BASE_URL=/api
RUN corepack pnpm run build

FROM nginx:1.27-alpine AS serve
COPY demo/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
